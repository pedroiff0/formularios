\usepackage{multicol}
\usepackage{geometry}
\usepackage[dvipsnames]{xcolor}
\usepackage{siunitx}
\geometry{margin=0.5cm}
\setlength{\columnsep}{1cm}
\pagestyle{empty}

% Configuração global do siunitx para melhor visualização
\sisetup{
  detect-all,
  output-decimal-marker = {,},
  group-separator = {.},
  group-minimum-digits = 4,
  exponent-product = \cdot,
  scientific-notation = engineering,
  output-exponent-marker = \mathrm{e},
  per-mode = symbol,
  inter-unit-product = ~,
  separate-uncertainty = true,
  tight-spacing = true,
  mode = text,
  detect-weight = true,
  detect-family = true,
  detect-shape = true,
  detect-mode = true,
}

% Definição de cores RGB
\definecolor{vermelhoRGB}{RGB}{200,30,30}
\definecolor{verdeRGB}{RGB}{30,160,60}
\definecolor{khaki}{RGB}{240,230,140}

% Comando para inserir fórmulas com explicações
% Uso: \formulabox[cor]{fórmula}{explicações}
% Requer: tcolorbox
\usepackage[most]{tcolorbox}

% Box customizada para fórmulas
\newtcolorbox{FormulaBox}[2][]{
  enhanced,
  colback=#1!5!white,
  colframe=#1,
  boxrule=0.5pt,
  arc=3pt,
  left=3pt,
  right=3pt,
  top=3pt,
  bottom=3pt,
  sharp corners=south,
  fontupper=\large\bfseries\color{#1}, % cor
  breakable,
  before skip=3pt, after skip=3pt,
  width=\columnwidth,
  halign=center,
  #2 % equacao
}

% Comando para inserir fórmulas com explicações
% Uso: \formulabox[cor][titulo]{fórmula}{explicações}
\newcommand{\formulabox}[4][blue]{%
  \vspace{0.5em}%
  \ifx&#2&\else{\small\noindent\textbf{#2}\par}\fi %titulo
    \begin{FormulaBox}[#1]{} % cor
    #3 % formula
  \end{FormulaBox}%
    \begin{flushleft}#4\end{flushleft}% descrição forms
}

% Comando para subfórmulas pequenas, sem título/descrição
% Uso: \subformulabox[cor]{fórmula}
% Comando para subfórmulas pequenas, com título opcional
% Uso: \subformulabox[cor][titulo]{fórmula}
\newcommand{\subformulabox}[3][purple]{%
  \ifx&#2&\else{\noindent\small{#2}\par}\fi
  \begin{FormulaBox}[#1]{width=\columnwidth, fontupper=\small\color{#1}}%
    #3
  \end{FormulaBox}%
}

% Comando para inserir constantes
% Uso: \constbox[cor]{constante}{valor e unidade}
\newcommand{\constbox}[3][black]{%
  {\noindent\small\color{#1}\textbf{#2}} = {#3} \\
}
