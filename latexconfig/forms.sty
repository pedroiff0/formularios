% Comando para inserir fórmulas com explicações
% Uso: \formulabox[cor]{fórmula}{explicações}
% Requer: tcolorbox
\usepackage[most]{tcolorbox}

% Box customizada para fórmulas
\newtcolorbox{FormulaBox}[2][]{
  enhanced,
  colback=#1!5!white,
  colframe=#1,
  boxrule=0.5pt,
  arc=3pt,
  left=3pt,
  right=3pt,
  top=3pt,
  bottom=3pt,
  sharp corners=south,
  fontupper=\large\bfseries\color{#1}, % cor
  breakable,
  before skip=3pt, after skip=3pt,
  width=\columnwidth,
  halign=center,
  #2 % equacao
}

% Comando para inserir fórmulas com explicações
% Uso: \formulabox[cor][titulo]{fórmula}{explicações}
\newcommand{\formulabox}[4][blue]{%
  \vspace{0.5em}%
  \ifx&#2&\else{\small\noindent\textbf{#2}\par}\fi %titulo
    \begin{FormulaBox}[#1]{} % cor
    #3 % formula
  \end{FormulaBox}%
    \begin{flushleft}#4\end{flushleft}% descrição forms
}

% Comando para subfórmulas pequenas, sem título/descrição
% Uso: \subformulabox[cor]{fórmula}
% Comando para subfórmulas pequenas, com título opcional
% Uso: \subformulabox[cor][titulo]{fórmula}
\newcommand{\subformulabox}[3][purple]{%
  \ifx&#2&\else{\noindent\small{#2}\par}\fi
  \begin{FormulaBox}[#1]{width=\columnwidth, fontupper=\small\color{#1}}%
    #3
  \end{FormulaBox}%
}

% Comando para inserir constantes
% Uso: \constbox[cor]{constante}{valor e unidade}
\newcommand{\constbox}[3][black]{%
  {\noindent\small\color{#1}\textbf{#2}} = {#3} \\
}

% Macros úteis para análise complexa e transformadas
% \Res: operador Res (resíduos)
% \pv: valor principal (principal value)
% \Laplace{f}: transformada de Laplace
% \InvLaplace{F}: transformada inversa de Laplace
% \Fourier{f}: transformada de Fourier
\DeclareMathOperator{\Res}{Res}
\newcommand{\pv}{\operatorname{p.v.}}
\newcommand{\Laplace}[1]{\mathcal{L}\{#1\}}
\newcommand{\InvLaplace}[1]{\mathcal{L}^{-1}\{#1\}}
\newcommand{\Fourier}[1]{\mathcal{F}\{#1\}}

% Caixa específica para folhas de cálculo básico (visual compacto)
\newtcolorbox{CalcBox}[2][]{
  enhanced,
  colback=#1!4!white,
  colframe=#1,
  boxrule=0.5pt,
  arc=3pt,
  left=6pt,
  right=6pt,
  top=4pt,
  bottom=4pt,
  sharp corners=south,
  fontupper=\normalsize\normalfont\color{#1},
  breakable,
  before skip=4pt, after skip=4pt,
  width=\columnwidth,
  halign=center,
  nobeforeafter,
  #2
}

% Macro de uso similar a \formulabox mas usando CalcBox
\newcommand{\calcbox}[4][blue]{%
  \vspace{0.2em}%
  \ifx&#2&\else{\small\noindent\textbf{#2}\par}\fi %titulo (se fornecido)
    \begin{CalcBox}[#1]{} % cor
    \centering
    #3 % formula(s)
  \end{CalcBox}%
    \begin{flushleft}\small #4\end{flushleft}% descricao
}

% Macro para prefixar linhas com travessão
\newcommand{\li}{\textemdash\ }

% O ambiente 'deducao' agora incrementa o contador de deduções ao iniciar
\newenvironment{deducao}[1][]{%
  % incrementa dedução e começa centralizado
  \begin{center}
  % se um título for fornecido, permite mostrá-lo (opcional)
  \ifx\relax#1\relax\else\textbf{#1}\par\fi
}{\end{center}}

% Macro para etapas de dedução em tcolorbox
\newcommand{\deducaostep}[3][BrickRed]{
\begin{tcolorbox}[
  title=\textbf{#2}, 
  colback=#1!5, 
  colframe=#1, 
  coltitle=white, 
  fonttitle=\normalsize\bfseries,   halign title=center,  sharp corners=south,
  arc=3pt, 
  boxrule=0.5pt, 
  left=3pt, 
  right=3pt, 
  top=3pt, 
  bottom=3pt] 
  #3 
\end{tcolorbox}
}

% Counter for chapters (minimal, to support \chapter redefinition)
\newcounter{chapternum}

% Define page-centered Chapter macro
\newcommand{\Chapter}[1]{%
  \refstepcounter{chapternum}% increment chapter counter
  \clearpage
  \thispagestyle{empty}
  \vspace*{\fill}
  \begin{center}
    {\Huge\bfseries Capítulo \arabic{chapternum}\\[1.5ex] #1}
  \end{center}
  \vspace*{\fill}
  \clearpage
}

% Apply renewcommand to \chapter if possible; fallback to newcommand if not defined
\ifcsname chapter\endcsname
  \renewcommand{\chapter}[1]{\Chapter{#1}}
\else
  \newcommand{\chapter}[1]{\Chapter{#1}}
\fi