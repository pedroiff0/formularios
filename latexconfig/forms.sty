% Redefinir os comandos de seção para não imprimir títulos, apenas atualizar numeração
% Mantém comportamento de seções "starred" (não numeradas) também
\RenewDocumentCommand{\section}{s o m}{%
  \IfBooleanTF{#1}{% starred - não numerada
    % nada
  }{%
    \refstepcounter{section}%
  }%
}
\RenewDocumentCommand{\subsection}{s o m}{%
  \IfBooleanTF{#1}{% starred
    % nada
  }{%
    \refstepcounter{subsection}%
  }%
}
\RenewDocumentCommand{\subsubsection}{s o m}{%
  \IfBooleanTF{#1}{% starred
    % nada
  }{%
    \refstepcounter{subsubsection}%
  }%
}
